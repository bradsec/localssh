# Copy to .env, then edit. Apply changes with `docker compose up -d`.

LOCALSSH_VERSION=latest

# 127.0.0.1 serves only the machine running Docker. Set 0.0.0.0 to serve the
# local network, and allow the port through the server firewall.
BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=9080

# Browser origins allowed to use the relay, matched exactly, scheme and port
# included. For a local network deployment use * instead: visitors reach the page
# by different addresses (IP, hostname, .local name) and each one would otherwise
# have to be listed here. ALLOWED_HOSTS is then the boundary that matters.
ALLOWED_ORIGINS=http://localhost:9080,http://127.0.0.1:9080

# SSH targets the relay may dial. * allows any host, which makes the relay an
# open proxy for anyone who can reach it, so prefer naming your own hosts.
# A leading *. matches subdomains, for example *.internal.example.
ALLOWED_HOSTS=*
ALLOWED_PORTS=22

# Relay resource limits.
MAX_SESSIONS=256
TARGET_CONNECT_TIMEOUT_MS=10000
